{
    "version": "2.0.0",
    "tasks":[
        {
            "label": "编译服务器",
            "type": "shell",
            "command": "gcc",
            "args": [
                "server.c",
                "-o",
                "server",
                "-lws2_32"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "编译客服端",
            "type": "shell",
            "command": "gcc",
            "args": [
                "client.c",
                "-o",
                "client",
                "-lws2_32"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}